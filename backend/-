
openapi: 3.0.3
info:
  title: App Cinco API
  version: 1.0.0
  description: Documentación de endpoints - App Cinco
paths:
  /auth/csrf/:
    get:
      operationId: auth_csrf_retrieve
      description: Establece la cookie CSRF para el frontend
      summary: Obtener CSRF token
      tags:
      - auth
      responses:
        '200':
          content:
            application/json:
              schema:
                detail: CSRF cookie set
          description: ''
  /auth/health/:
    get:
      operationId: auth_health_retrieve
      description: Verifica el estado del backend y conexiones a bases de datos
      summary: Health Check
      tags:
      - auth
      responses:
        '200':
          content:
            application/json:
              schema:
                description: Sistema saludable
                example:
                  status: healthy
                  service: app-cinco-backend
                  databases:
                    default: connected
                    azul: connected
          description: ''
        '503':
          content:
            application/json:
              schema:
                description: Sistema no disponible
                example:
                  status: unhealthy
                  service: app-cinco-backend
                  error: Database connection failed
          description: ''
  /auth/legacy/exchange/:
    post:
      operationId: auth_legacy_exchange_create
      description: Valida un `legacy_token` firmado por el sistema externo y emite
        `access_token` y `refresh_token` del backend.
      summary: Intercambio legacy sin contraseña
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/LegacyExchangeRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/LegacyExchangeRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/LegacyExchangeRequest'
        required: true
      security:
      - ApiKeyAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/LegacyLoginResponse'
          description: ''
        '401':
          content:
            application/json:
              schema:
                detail: legacy_token inválido o API Key inválida
          description: ''
  /auth/legacy/login/:
    post:
      operationId: auth_legacy_login_create
      description: Autentica un usuario real para una integración legacy. Requiere
        `X-API-Key` y retorna `access_token` y `refresh_token` en JSON.
      summary: Login legacy con API Key
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/LoginRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/LoginRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/LoginRequest'
        required: true
      security:
      - ApiKeyAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/LegacyLoginResponse'
          description: ''
        '401':
          content:
            application/json:
              schema:
                detail: Credenciales inválidas o API Key inválida
          description: ''
  /auth/legacy/refresh/:
    post:
      operationId: auth_legacy_refresh_create
      description: Renueva tokens para una integración legacy. Requiere `X-API-Key`
        y `refresh_token` en el body.
      summary: Refresh legacy con API Key
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/RefreshTokenRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/RefreshTokenRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/RefreshTokenRequest'
        required: true
      security:
      - ApiKeyAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/LegacyRefreshTokenResponse'
          description: ''
        '401':
          content:
            application/json:
              schema:
                detail: Refresh token inválido o API Key inválida
          description: ''
  /auth/login/:
    post:
      operationId: auth_login_create
      description: Autenticación de usuario y generación de tokens JWT
      summary: Login de usuario
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/LoginRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/LoginRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/LoginRequest'
        required: true
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/LoginResponse'
          description: ''
        '400':
          content:
            application/json:
              schema:
                detail: Usuario y contraseña requeridos
          description: ''
        '401':
          content:
            application/json:
              schema:
                detail: Credenciales inválidas
          description: ''
  /auth/logout/:
    post:
      operationId: auth_logout_create
      description: Revoca el refresh token y limpia las cookies de autenticación
      summary: Cerrar sesión
      tags:
      - auth
      responses:
        '200':
          content:
            application/json:
              schema:
                detail: Logout successful
          description: ''
        '400':
          content:
            application/json:
              schema:
                detail: No refresh token found
          description: ''
  /auth/refresh/:
    post:
      operationId: auth_refresh_create
      description: Genera un nuevo access token rotando el refresh token
      summary: Renovar token de acceso
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/RefreshTokenRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/RefreshTokenRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/RefreshTokenRequest'
        required: true
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/RefreshTokenResponse'
          description: ''
        '400':
          content:
            application/json:
              schema:
                detail: refresh_token is required
          description: ''
        '401':
          content:
            application/json:
              schema:
                detail: Invalid or expired refresh token
          description: ''
  /auth/session/:
    get:
      operationId: auth_session_retrieve
      description: Retorna los datos del usuario autenticado según el access token
        en cookie httpOnly.
      summary: Validar sesión actual
      tags:
      - auth
      security:
      - ApiKeyAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/SessionResponse'
          description: ''
        '401':
          content:
            application/json:
              schema:
                detail: No autenticado o token inválido
          description: ''
  /empleados/empleados/:
    get:
      operationId: empleados_empleados_list
      description: "\n        Obtiene un listado de empleados con filtros avanzados.\n
        \       \n        **Filtrado automático por estado:**\n        - Si no envías
        `estado`, retorna solo empleados `ACTIVO`\n        - Si envías `estado`, filtra
        por ese valor (`ACTIVO`, `INACTIVO`, `SUSPENDIDO`)\n        \n        **Parámetros
        de filtro disponibles:**\n        - `search`: Búsqueda general en cédula,
        nombre, apellido, cargo, móvil\n        - `cedula`, `nombre`, `apellido`,
        `area`, `carpeta`, `cargo`, `movil`\n        - `supervisor`, `sede`, `codigo_sap`,
        `estado`\n        \n        **Campos incluidos:**\n        - id, cédula, nombre,
        apellido, área, carpeta, cargo, móvil, estado, etc.\n        "
      summary: Listar empleados activos
      parameters:
      - in: query
        name: apellido
        schema:
          type: string
        description: Filtra por apellido (búsqueda parcial)
      - in: query
        name: area
        schema:
          type: string
        description: Filtra por área (búsqueda parcial)
      - in: query
        name: cargo
        schema:
          type: string
        description: Filtra por cargo (búsqueda parcial)
      - in: query
        name: carpeta
        schema:
          type: string
        description: Filtra por carpeta (búsqueda parcial)
      - in: query
        name: cedula
        schema:
          type: string
        description: Filtra por cédula (búsqueda parcial)
      - in: query
        name: codigo_sap
        schema:
          type: string
        description: Filtra por código SAP (búsqueda parcial)
      - in: query
        name: estado
        schema:
          type: string
          enum:
          - ACTIVO
          - INACTIVO
          - SUSPENDIDO
        description: 'Filtra por estado. Valores: ACTIVO, INACTIVO, SUSPENDIDO'
      - in: query
        name: movil
        schema:
          type: string
        description: Filtra por móvil (búsqueda parcial)
      - in: query
        name: nombre
        schema:
          type: string
        description: Filtra por nombre (búsqueda parcial)
      - in: query
        name: search
        schema:
          type: string
        description: Búsqueda en cédula, nombre, apellido, cargo o móvil (búsqueda
          parcial, insensible a mayúsculas)
      - in: query
        name: sede
        schema:
          type: string
        description: Filtra por sede (búsqueda parcial)
      - in: query
        name: supervisor
        schema:
          type: string
        description: Filtra por supervisor (búsqueda parcial)
      tags:
      - empleados
      security:
      - ApiKeyAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Empleado'
          description: ''
    post:
      operationId: empleados_empleados_create
      description: "\n        Crea un nuevo empleado.\n        \n        **Campos
        requeridos:**\n        - cedula: Cédula única\n        - nombre: Nombre del
        empleado\n        - apellido: Apellido del empleado\n        - cargo: Cargo
        del empleado\n        - area: Área a la que pertenece\n        - carpeta:
        Carpeta asignada\n        - movil: Número de móvil\n        \n        **Campos
        opcionales:**\n        - estado: Estado del empleado (por defecto ACTIVO)\n
        \       - email: Correo electrónico\n        "
      summary: Crear un nuevo empleado
      tags:
      - empleados
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Empleado'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/Empleado'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/Empleado'
        required: true
      security:
      - ApiKeyAuth: []
      - BearerAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Empleado'
          description: ''
  /empleados/empleados/{id}/:
    get:
      operationId: empleados_empleados_retrieve
      description: Obtiene toda la información de un empleado específico
      summary: Obtener detalles de un empleado
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: Un valor de entero único que identifique este empleado.
        required: true
      tags:
      - empleados
      security:
      - ApiKeyAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Empleado'
          description: ''
    put:
      operationId: empleados_empleados_update
      description: Actualiza todos los campos de un empleado. Se requieren todos los
        campos requeridos.
      summary: Actualizar un empleado completamente
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: Un valor de entero único que identifique este empleado.
        required: true
      tags:
      - empleados
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Empleado'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/Empleado'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/Empleado'
        required: true
      security:
      - ApiKeyAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Empleado'
          description: ''
    patch:
      operationId: empleados_empleados_partial_update
      description: Actualiza solo los campos proporcionados de un empleado.
      summary: Actualizar parcialmente un empleado
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: Un valor de entero único que identifique este empleado.
        required: true
      tags:
      - empleados
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedEmpleado'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedEmpleado'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedEmpleado'
      security:
      - ApiKeyAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Empleado'
          description: ''
    delete:
      operationId: empleados_empleados_destroy
      description: "\n        Realiza soft delete por defecto cambiando `estado` a
        `INACTIVO`.\n\n        **Eliminación física (caso específico):**\n        -
        Enviar `?hard_delete=true`\n        - Requiere una cuenta administradora (`is_superuser`)\n
        \       "
      summary: Eliminar un empleado
      parameters:
      - in: query
        name: hard_delete
        schema:
          type: boolean
        description: Si es true y la cuenta es superusuaria, elimina físicamente el
          registro
      - in: path
        name: id
        schema:
          type: integer
        description: Un valor de entero único que identifique este empleado.
        required: true
      tags:
      - empleados
      security:
      - ApiKeyAuth: []
      - BearerAuth: []
      responses:
        '204':
          description: No response body
  /empleados/empleados/{id}/certificado-laboral/:
    get:
      operationId: empleados_empleados_certificado_laboral_retrieve
      description: "\n        Genera un certificado laboral en PDF a partir de la
        información del empleado y\n        del complemento en `cinco_base_de_personal_siigo`.\n\n
        \       **Fuente principal de datos:**\n        - `cinco_base_de_personal`:
        nombre, cédula, cargo base, fecha ingreso\n        - `cinco_base_de_personal_siigo`:
        salario, tipo contrato, cargo SIIGO y extras JSON\n\n        **Parámetros
        opcionales:**\n        - `document_type`: fuerza el tipo de documento (`CC`,
        `PT`, `TI`, `CE`)\n        "
      summary: Generar certificado laboral en PDF
      parameters:
      - in: query
        name: document_type
        schema:
          type: string
          enum:
          - CC
          - CE
          - PT
          - TI
        description: Tipo de documento a marcar en el certificado
      - in: path
        name: id
        schema:
          type: integer
        description: Un valor de entero único que identifique este empleado.
        required: true
      tags:
      - empleados
      security:
      - ApiKeyAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/pdf:
              schema:
                type: string
                format: binary
          description: Archivo PDF del certificado laboral.
    post:
      operationId: empleados_empleados_certificado_laboral_create
      description: "\n        Genera un certificado laboral en PDF a partir de la
        información del empleado y\n        del complemento en `cinco_base_de_personal_siigo`.\n\n
        \       **Fuente principal de datos:**\n        - `cinco_base_de_personal`:
