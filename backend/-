  /operaciones/actividades/:
    get:
      operationId: operaciones_actividades_list
      description: "\n        Obtiene un listado de actividades filtradas según el
        perfil del usuario actual.\n        \n        **Comportamiento de filtrado
        por perfil:**\n        - Por defecto, solo muestra actividades que el usuario
        creó (created_by) \n          O donde es el responsable (responsable_snapshot.empleado_id)\n
        \       \n        **Parámetros de filtrado disponibles:**\n        - `ot`:
        Filtra por alguna OT relacionada (búsqueda parcial)\n        - `estado`: Filtra
        por estado (pendiente, en_progreso, completada, cancelada, pausada, reprogramada)\n
        \       - `area`: Filtra por área del responsable (búsqueda parcial)\n        -
        `carpeta`: Filtra por carpeta del responsable (búsqueda parcial)\n        -
        `responsable_id`: Filtra por ID del empleado responsable\n        - `buscar`:
        Búsqueda general en descripción, tipo de trabajo, OT y nombre del responsable\n
        \       - `zona`: Filtra por zona de ubicación (búsqueda parcial)\n        -
        `nodo`: Filtra por nodo de ubicación (búsqueda parcial)\n        - `fecha_inicio_desde`:
        Filtra actividades con fecha de inicio >= a esta fecha (YYYY-MM-DD)\n        -
        `fecha_inicio_hasta`: Filtra actividades con fecha de inicio <= a esta fecha
        (YYYY-MM-DD)\n        "
      summary: Listar actividades/solicitudes
      parameters:
      - in: query
        name: area
        schema:
          type: string
        description: Filtra por área del responsable (búsqueda parcial)
      - in: query
        name: buscar
        schema:
          type: string
        description: Búsqueda general en descripción, tipo de trabajo, OT y nombre
          del responsable
      - in: query
        name: carpeta
        schema:
          type: string
        description: Filtra por carpeta del responsable (búsqueda parcial)
      - in: query
        name: estado
        schema:
          type: string
          enum:
          - cancelada
          - completada
          - en_progreso
          - pausada
          - pendiente
          - reprogramada
        description: 'Filtra por estado de la actividad. Valores: pendiente, en_progreso,
          completada, cancelada, pausada, reprogramada'
      - in: query
        name: fecha_inicio_desde
        schema:
          type: string
          format: date
        description: Filtra actividades con fecha de inicio >= a esta fecha (YYYY-MM-DD)
      - in: query
        name: fecha_inicio_hasta
        schema:
          type: string
          format: date
        description: Filtra actividades con fecha de inicio <= a esta fecha (YYYY-MM-DD)
      - in: query
        name: nodo
        schema:
          type: string
        description: Filtra por nodo de ubicación (búsqueda parcial)
      - in: query
        name: ot
        schema:
          type: string
        description: 'Filtra por alguna OT relacionada (búsqueda parcial). Ej: OT-2024-001'
      - in: query
        name: responsable_id
        schema:
          type: integer
        description: Filtra por ID del empleado responsable
      - in: query
        name: zona
        schema:
          type: string
        description: Filtra por zona de ubicación (búsqueda parcial)
      tags:
      - operaciones
      security:
      - ApiKeyAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Actividad'
          description: ''
    post:
      operationId: operaciones_actividades_create
      description: "\n        Crea una nueva actividad con sus detalles de ubicación.\n
        \       \n        **Nota:** La actividad será creada por el usuario autenticado
        (created_by).\n        El responsable debe ser un empleado válido existente
        en la base de datos de empleados.\n        \n        **Campos requeridos:**\n
        \       - `ots`: Lista de OTs relacionadas. Debe incluir al menos una.\n        -
        `responsable_id`: ID del empleado responsable\n        - `detalle`: Objeto
        con descripción y tipo de trabajo\n        - `ubicacion`: Objeto con datos
        de ubicación\n        \n        **Campos opcionales:**\n        - `fecha_inicio`:
        Fecha de inicio (YYYY-MM-DD)\n        - `fecha_fin_estimado`: Fecha fin estimada
        (YYYY-MM-DD)\n        - `fecha_fin_real`: Fecha fin real (YYYY-MM-DD)\n        "
      summary: Crear una nueva actividad/solicitud
      tags:
      - operaciones
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ActividadWrite'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/ActividadWrite'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/ActividadWrite'
        required: true
      security:
      - ApiKeyAuth: []
      - BearerAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Actividad'
          description: ''
